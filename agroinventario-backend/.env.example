# Copiar este archivo como .env en la raíz del proyecto (no se versiona)
# En Windows PowerShell: Copy-Item .env.example .env

# Perfil activo: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Servidor
SERVER_PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agroinventario
DB_USERNAME=agro_user
DB_PASSWORD=agro_secret

# JPA (Fase 1: sin entidades → none)
JPA_DDL_AUTO=none
JPA_SHOW_SQL=true

# JWT (Fase 3 - valores de ejemplo, cambiar en producción)
JWT_SECRET=CAMBIAR_ESTE_SECRETO_POR_UNO_LARGO_Y_ALEATORIO_MIN_256_BITS
JWT_EXPIRATION_MS=86400000

# Alertas (Fase 5)
ALERTAS_DIAS_ANTICIPACION=30
ALERTAS_CRON_VENCIMIENTO=0 0 6 * * *
