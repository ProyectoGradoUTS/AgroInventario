# Copiar este archivo como .env en la raíz del proyecto (no se versiona)
# En Windows PowerShell: Copy-Item .env.example .env

# Perfil activo: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Servidor
SERVER_PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agroinventario
DB_USERNAME=agro_user
DB_PASSWORD=agro_secret

# JPA (Flyway controla el esquema; Hibernate solo valida)
JPA_SHOW_SQL=true

# JWT (Fase 3 - valores de ejemplo, cambiar en producción)
JWT_SECRET=CAMBIAR_ESTE_SECRETO_POR_UNO_LARGO_Y_ALEATORIO_MIN_256_BITS
JWT_EXPIRATION_MS=86400000

# Alertas (Fase 5)
ALERTAS_DIAS_ANTICIPACION=30
ALERTAS_CRON_VENCIMIENTO=0 0 6 * * *

# Correo SMTP (Gmail)
# El remitente debe ser una cuenta Gmail con "Contraseña de aplicación" habilitada
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_password_de_aplicacion

# Correo al que se enviarán las alertas de vencimiento
ALERTAS_EMAIL_DESTINO=destinatario@correo.com
